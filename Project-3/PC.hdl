// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    //// Replace this comment with your code.
    // Current value + 1
    Inc16(in=stored, out=incremented);

    // Select increment or current value
    Mux16(a=stored, b=incremented, sel=inc, out=incResult);

    // Select input if load=1
    Mux16(a=incResult, b=in, sel=load, out=loadResult);

    // Select 0 if reset=1
    Mux16(a=loadResult, b=false, sel=reset, out=next);

    // Register
    Register(in=next, load=true, out=stored);

    // Output
    Mux16(a=stored, b=stored, sel=false, out=out);
}